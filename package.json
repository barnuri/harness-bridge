  "description": "Use your Claude Code setup (plugins, skills, agents, commands, MCP) from opencode and pi — via symlinks, without duplicating files",
  "type": "module",
  "main": "src/plugin.js",
  "exports": { ".": "./src/plugin.js" },
  "files": ["bin", "src", "README.md", "LICENSE"],
