    "test": "bash test/claude-harness-sync.test.sh",
    "sync": "bash bin/claude-harness-sync.sh",
    "report": "bash bin/claude-harness-sync.sh --report"
  },
  "keywords": ["claude-code", "opencode", "pi", "agent-skills", "mcp", "symlink", "sync"],
  "license": "MIT",
  "peerDependencies": { "@opencode-ai/plugin": ">=1.18.0" },
  "peerDependenciesMeta": { "@opencode-ai/plugin": { "optional": true } }
